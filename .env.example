APP_NAME="LEVADA SERVICE"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://livada-center.by

# Локаль сайта — русский (Беларусь).
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ───────────────────────────────────────────────────────────────────────────
# База данных НЕ используется: весь контент в config/levada.php и app/Data/*.
# Драйверы ниже — файловые, поэтому хостингу не нужны MySQL/Redis/Memcached.
# ───────────────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@livada-center.by"
MAIL_FROM_NAME="${APP_NAME}"

# ───────────────────────────────────────────────────────────────────────────
# Telegram: заявки с формы уходят сюда. Токен — у @BotFather,
# chat_id — числовой ID чата/канала (для группы — со знаком минус).
# ───────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
