# =============================================================
#  Шаблон переменных окружения.
#  Скопируйте в .env.local и подставьте реальные значения:
#     cp .env.example .env.local
#  .env.local в git НЕ попадает (секреты).
# =============================================================

# Токен бота от @BotFather (формат: 1234567890:AA...)
TELEGRAM_BOT_TOKEN=

# ID чата/группы администраторов, куда бот шлёт заявки.
# Для группы — отрицательное число (напр. -5584560311),
# для супергруппы обычно вида -100xxxxxxxxxx.
TELEGRAM_CHAT_ID=
