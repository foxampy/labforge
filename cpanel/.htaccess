# .htaccess для статического экспорта Next.js (output:'export', trailingSlash:true)
# на Apache/cPanel. Назначение: gzip-сжатие, долгий кэш статики, страница 404,
# прямое обслуживание PHP-обработчика формы lead.php.

# --- Кодировка по умолчанию ---
AddDefaultCharset UTF-8

# --- gzip / deflate сжатие текстовых ресурсов ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/x-font-ttf font/ttf font/opentype
</IfModule>

# --- Кэш-заголовки для статики (картинки, шрифты, js/css) ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Изображения и шрифты — год, immutable (имена с хэшами).
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType font/woff               "access plus 1 year"
  ExpiresByType font/ttf                "access plus 1 year"
  ExpiresByType application/font-woff2  "access plus 1 year"

  # JS / CSS — год (Next.js хэширует имена файлов).
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"

  # HTML — без долгого кэша, чтобы правки страниц подхватывались.
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# Длинный immutable-кэш для хэшированных ассетов Next.js и медиа/шрифтов.
<IfModule mod_headers.c>
  <FilesMatch "\.(svg|jpg|jpeg|png|gif|webp|avif|ico|woff2|woff|ttf|js|css|mjs)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML не кэшируем агрессивно.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- PHP-обработчик формы обслуживается напрямую ---
# Гарантируем, что lead.php исполняется как PHP и не попадает под какие-либо
# правила переписывания URL.
<Files "lead.php">
  <IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ - [L]
  </IfModule>
</Files>

# --- Кастомная страница 404 ---
# Next.js при экспорте кладёт 404.html в корень out/.
ErrorDocument 404 /404.html

# Примечание: чистые URL вида /uslugi/ Apache отдаёт сам через DirectoryIndex
# (index.html внутри каталога), поэтому собственные правила переписывания
# для папок здесь не нужны и намеренно не добавлены.
